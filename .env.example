# 环境变量示例文件。
#
# 使用方法：
#   cp .env.example .env
# 然后按实际环境修改值。Docker Compose 会自动读取同目录下的 .env。
#
# 设计说明（教学向）
# =================
# 1. 规格 §3.2 要求所有配置从 .env 读取；本文件列出全部可配置项及默认值。
# 2. 本地直接跑 uvicorn 时用 localhost；在 docker compose 内运行时，
#    docker-compose.yml 已用服务名（postgres/redis/qdrant）覆盖 *_HOST。
# 3. 切勿把真实密钥提交进仓库；.env 已在 .gitignore 中忽略。

# ---- 通用 ----
DEBUG=false

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=cybersec
POSTGRES_DB=cybersec_rag

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 本地开发默认无密码；生产请设置强密码
REDIS_PASSWORD=

# ---- Qdrant ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=cybersec_chunks

# ---- Phase 2：上传与本地存储 ----
STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_MB=20
# 逗号分隔；FastAPI 上传时会同时检查扩展名与 MIME
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.md,.markdown,.txt
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/markdown,text/plain,text/x-markdown

# ---- 后端服务端口 ----
BACKEND_PORT=8000

# ---- 以下为后续 Phase 预留项（Phase 0 不使用，仅占位提醒）----
# 本地 Embedding 模型目录（Phase 5）
EMBEDDING_MODEL_PATH=models/embedding
# 本地 Reranker 模型目录（Phase 5）
RERANKER_MODEL_PATH=models/reranker
# LLM API key 与 base_url（Phase 7+，来自 Doc/LLMAPKKEY.txt，请勿提交真实 key）
LLM_API_KEY=
LLM_BASE_URL=
